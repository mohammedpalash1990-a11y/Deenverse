# DEENVERSE local configuration template
# Copy to .env locally; never commit real credentials.
APP_ENV=development
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Configure only after the architecture and provider are approved.
DATABASE_URL=
AUTH_SECRET=

# Optional external services; leave blank until legally and technically approved.
QURAN_CONTENT_PROVIDER=
QURAN_CONTENT_API_KEY=
AUDIO_CDN_BASE_URL=
AUDIO_PROVIDER_API_KEY=

# Public client configuration is not a substitute for backend security rules.
