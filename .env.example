# Environment configuration template for DEENVERSE
# Copy this file to .env and provide local values.
# NEVER commit .env or real credentials to source control.

# Server settings
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Allowed CORS origins (comma-separated allowlist; unknown origins blocked with 403)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Database Client: 'sqlite3' (default for local/tests) or 'pg' (production)
DB_CLIENT=sqlite3
DB_FILENAME=./deenverse.sqlite

# Production PostgreSQL URL (used when DB_CLIENT=pg)
# DATABASE_URL=postgresql://user:password@localhost:5432/deenverse

# Authentication and session configuration
# Keep empty in this template. Generate a unique cryptographically random secret locally.
# The application must reject missing or weak secrets before enabling authentication.
JWT_SECRET=
