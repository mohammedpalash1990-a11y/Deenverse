# DEENVERSE environment configuration template
# Copy to .env locally; never commit real credentials.

# Application and server
APP_ENV=development
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS allowlist (comma-separated; unknown origins must be rejected)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Database configuration
DB_CLIENT=sqlite3
DB_FILENAME=./deenverse.sqlite
DATABASE_URL=

# Authentication; generate unique cryptographically random values locally
AUTH_SECRET=
JWT_SECRET=

# Optional external services; leave blank until legally and technically approved
QURAN_CONTENT_PROVIDER=
QURAN_CONTENT_API_KEY=
AUDIO_CDN_BASE_URL=
AUDIO_PROVIDER_API_KEY=

# Public client configuration is not a substitute for backend security rules.
