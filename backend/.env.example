# DEENVERSE Backend Environment Configuration
# Placeholder values only. Never commit real secrets or production credentials.

# Server configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# CORS allowlist (comma-separated browser origins). CORS_ALLOWED_ORIGINS is also accepted as an alias for CORS_ORIGIN.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Quran content remains unavailable until a separately reviewed source artifact and approval record exist. Never seed approval rows from this environment file or configure a provider as a substitute for that review.

# Quran team review links — use a unique secret of at least 32 random bytes in production.
QURAN_REVIEW_ADMIN_TOKEN=
PUBLIC_APP_URL=http://localhost:3000

# Authentication & Security
# Set a unique cryptographically random secret locally before enabling auth/session features.
# Leave empty in this template; the application must reject missing/weak secrets when auth is enabled.
JWT_SECRET=
JWT_EXPIRES_IN=7d
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Database Configuration
# Local development/testing database
DB_CLIENT=sqlite3
DB_FILENAME=./deenverse.sqlite

# Production PostgreSQL. Set NODE_ENV=production and provide DATABASE_URL.
# DATABASE_URL=postgresql://user:password@localhost:5432/deenverse
# DB_CLIENT=pg
