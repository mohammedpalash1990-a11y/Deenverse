# DEENVERSE Backend Environment Configuration
# Placeholder values only. Never commit real secrets or production credentials.

# Server configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# CORS allowlist (comma-separated browser origins). CORS_ALLOWED_ORIGINS is also accepted as an alias for CORS_ORIGIN.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Authentication & Security
# Set a unique cryptographically random secret locally before enabling auth/session features.
# Leave empty in this template; the application must reject missing/weak secrets when auth is enabled.
JWT_SECRET=
JWT_EXPIRES_IN=7d
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Database Configuration
# The current migration CLI supports SQLite only. Do not set DB_CLIENT=pg until PostgreSQL migrations are implemented and tested.
# Supported clients: 'sqlite3' for local/testing, 'pg' for production PostgreSQL
DB_CLIENT=sqlite3
DB_FILENAME=./deenverse.sqlite

# Production PostgreSQL configuration (takes precedence when DB_CLIENT=pg or if DATABASE_URL starts with postgresql://)
# DATABASE_URL=postgresql://user:password@localhost:5432/deenverse
