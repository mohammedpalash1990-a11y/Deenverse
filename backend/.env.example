# DEENVERSE backend local configuration
# Copy to .env locally. Never commit secrets or production credentials.

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# SQLite is supported by the current migration CLI.
DB_CLIENT=sqlite3
DB_FILENAME=./deenverse.sqlite

# Exact browser origins, comma-separated. Leave empty to deny browser CORS.
# Must match the variable read by backend/src/app.ts.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL runtime support is not yet enabled in the migration CLI.
# Do not set DB_CLIENT=pg until PostgreSQL connection and migrations are implemented.
